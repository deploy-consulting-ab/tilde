// prisma/schema.prisma
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    // uncomment next line if you use Prisma <5.10
    // directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
    provider = "prisma-client-js"
}
// Base container for system permissions
model Profile {
    id          String       @id @default(cuid())
    name        String       @unique
    description String?
    systemPermissions SystemPermission[] // Enable simple and intuitive queries. Like parent to child (__r) in SF
    fieldPermissions  FieldPermission[]
    users       User[]
}

// Collections of system permissions
model PermissionSet {
    id          String       @id @default(cuid())
    name        String       @unique
    description String?
    systemPermissions SystemPermission[] // Enable simple and intuitive queries. Like parent to child (__r) in SF
    fieldPermissions  FieldPermission[]
    users       User[] // Many-to-many relationship with users
}

// Field-level permissions for external systems (Salesforce, Flex, etc.)
// system: "salesforce" | "flex" | ...
// objectName: e.g. "Assignment__c", "Opportunity"
// fieldName: e.g. "ActualAmount__c", "StartDate__c"
model FieldPermission {
    id          String          @id @default(cuid())
    system      String
    objectName  String
    fieldName   String
    label       String?
    description String?
    profiles       Profile[]
    permissionSets PermissionSet[]

    @@unique([system, objectName, fieldName])
}

// System permissions. i.e. Home:View, Holidays:View, Assignments:View, Lead:Create, etc
model SystemPermission {
    id             String          @id @default(cuid())
    name           String          @unique
    description    String?
    profiles       Profile[] // Many-to-many relationship with profiles
    permissionSets PermissionSet[] // Many-to-many relationship with permission sets
}

model User {
    id              String          @id @default(cuid())
    name            String?
    email           String          @unique
    emailVerified   DateTime?
    employeeNumber String?         @unique
    flexEmployeeId  String?         @unique
    image           String?
    password        String?
    profile         Profile         @relation(fields: [profileId], references: [id])
    profileId       String          @default("deploy_consultant")
    homeLayoutKey   String?
    permissionSets  PermissionSet[] 
    accounts        Account[]
    timereportCheckmarks TimereportCheckmark[]
    isActive        Boolean         @default(true)
    sessionVersion  Int             @default(0)
    yearlyHolidays  Float           @default(30)
    carriedOverHolidays Float       @default(0)

    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt
}

model Account {
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([provider, providerAccountId])
}

model TimereportCheckmark {
    id            String   @id @default(cuid())
    userId        String
    weekStartDate DateTime
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, weekStartDate])
    @@index([userId])
    @@index([weekStartDate])
}

// Financial records by fiscal year and quarter (FY: Feb 1 – Jan 31)
// quarter: 1-4 for Q1-Q4, 0 = Total Year (stored explicitly)
model FinancialRecord {
    id         String   @id @default(cuid())
    fiscalYear Int
    quarter    Int
    revenue    Float
    cost       Float
    profit     Float
    taxes      Float
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([fiscalYear, quarter])
    @@index([fiscalYear])
}
